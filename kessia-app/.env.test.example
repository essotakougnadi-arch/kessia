# ============================================================
# KESSIA — Base de test ISOLÉE (E2E + tests d'intégration)
#
# Copier en .env.test (jamais commité) et renseigner une base DÉDIÉE
# aux tests — surtout PAS la base de démo de .env.local.
#
# Puis :
#   npm run db:test:reset          # schéma neuf + seed sur cette base
#   npm run build && npm run test:e2e:isolated
#
# Le reset refuse de tourner si cette URL == celle de .env.local.
# Voir docs/development/testing.md.
# ============================================================

# Option A — projet ou branche Supabase séparé (recommandé)
DATABASE_URL="postgresql://postgres:PASSWORD@db.XXXX.supabase.co:5432/postgres"

# Option B — Postgres local (Docker)
#   docker run -d --name kessia-test -e POSTGRES_PASSWORD=kessia \
#     -e POSTGRES_DB=kessia_test -p 5433:5432 postgres:16
# DATABASE_URL="postgresql://postgres:kessia@localhost:5433/kessia_test"
