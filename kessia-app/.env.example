# ============================================================
# KESSIA — Variables d'environnement (modèle)
# Copier vers .env.local et renseigner. NE JAMAIS committer .env / .env.local
# ============================================================

# ── Base de données (Supabase / PostgreSQL) ────────────────
# Prisma lit UNIQUEMENT DATABASE_URL (schema.prisma → env("DATABASE_URL")).
#
# • En local / pour `prisma db push` / migrations : pooler SESSION (port 5432)
#     DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/postgres"
#
# • Sur un hébergeur serverless (Vercel) : pooler TRANSACTION (port 6543)
#   — le mode session plafonne à ~15 connexions et sature (ADR 0039) :
#     DATABASE_URL="postgresql://USER:PASSWORD@HOST:6543/postgres?pgbouncer=true&connection_limit=1"
#   Ne JAMAIS lancer `prisma db push` sur le port 6543 (pgbouncer casse le DDL).
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/postgres"
# Vestigial : documenté par le passé mais NON lu par le code.
DATABASE_URL_POOLER=""

# ── JWT / sessions ────────────────────────────────────────
JWT_SECRET="change-me"
JWT_REFRESH_SECRET="change-me"
JWT_ACCESS_EXPIRY="15m"
JWT_REFRESH_EXPIRY="30d"
NEXTAUTH_SECRET="change-me"
NEXTAUTH_URL="http://localhost:3000"

# ── Supabase (client + service) ───────────────────────────
NEXT_PUBLIC_SUPABASE_URL="https://PROJECT.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY=""
SUPABASE_SERVICE_ROLE_KEY=""              # requis pour le stockage KYC (ADR 0014)
SUPABASE_KYC_BUCKET="kyc-documents"       # bucket PRIVÉ
SUPABASE_TICKET_BUCKET="ticket-attachments" # bucket PRIVÉ — pièces jointes de ticket (§46, ADR 0018)
SUPABASE_AVATARS_BUCKET="avatars"

# ── Rate limiting distribué (optionnel — repli mémoire sinon, ADR 0014) ──
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""

# ── Tâches planifiées & sécurité d'exploitation ───────────
CRON_SECRET=""                            # protège /api/v1/cron/tontine-tick
METRICS_TOKEN=""                          # protège /api/metrics (Prometheus)
PAYMENT_WEBHOOK_SECRET=""                 # HMAC des webhooks paiement

# ── Livraison Miaride (ADR 0042) ─────────────────────────
# Tant que MIARIDE_WEBHOOK_SECRET est vide : suivi SIMULÉ (démo).
MIARIDE_ENABLED="1"                       # "0" pour masquer l'option livraison
MIARIDE_DISPATCH_URL=""                   # base du lien de commande (wa.me ou web) — mode hand-off
MIARIDE_TRACKING_BASE=""                  # base des URLs de suivi Miaride
MIARIDE_WEBHOOK_SECRET=""                 # HMAC des webhooks de statut livraison

# ── KESSIA AI — vrai LLM (optionnel, ADR 0046) ───────────
# Par défaut l'assistant tourne en mode « règles + données » (gratuit).
# Pour brancher Claude sur la « longue traîne » des questions :
#   1. renseigner ANTHROPIC_API_KEY
#   2. mettre KESSIA_AI_LLM="1"   (opt-in explicite = budget validé)
# Coût : le modèle par défaut est claude-opus-5. Pour un assistant de
# chat à volume, claude-haiku-4-5 (~$1/$5 le M tokens) ou
# claude-sonnet-5 sont nettement moins chers — ajuster KESSIA_AI_MODEL.
ANTHROPIC_API_KEY=""
KESSIA_AI_LLM="0"                          # "1" pour activer l'appel LLM
KESSIA_AI_MODEL="claude-opus-5"            # claude-haiku-4-5 / claude-sonnet-5 pour réduire le coût

# ── Notifications — canaux réels (optionnels, ADR 0013) ───
# Tant qu'ils sont vides : push / SMS / email en SIMULATION.
PUSH_PROVIDER_KEY=""
SMS_PROVIDER_KEY=""
EMAIL_PROVIDER_KEY=""
NOTIFY_WEBHOOK_URL=""
NOTIFY_WEBHOOK_SECRET=""
SMS_PROVIDER="DEV"

# ── E-mail transactionnel (devis / factures / reçus PDF, ADR 0032) ──
# Vide : envoi SIMULÉ (log serveur, journalisé, aucun mail réel).
RESEND_API_KEY=""
EMAIL_FROM="KESSIA <no-reply@kessia.app>"

# ── Mode démonstration ────────────────────────────────────
# Déploiement public SANS fournisseur SMS : renvoie les codes OTP dans
# les réponses de l'API pour que l'inscription reste testable en ligne.
# Ignoré si SMS_PROVIDER ≠ "DEV". JAMAIS sur un déploiement avec de
# vrais utilisateurs.
# DEMO_MODE="1"                 # serveur : expose l'OTP
# NEXT_PUBLIC_DEMO_MODE="1"     # client : bandeau + comptes de test sur /login

# ── Divers ────────────────────────────────────────────────
NODE_ENV="development"
# E2E uniquement — JAMAIS sur un déploiement réel :
# E2E_RATE_LIMIT_BYPASS="1"
